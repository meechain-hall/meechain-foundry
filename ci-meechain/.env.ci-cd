# ═══════════════════════════════════════════════════════════════
# 🏰 MeeChain CI/CD & Dashboard Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Store this file as .env.local (Git ignored - never commit!)
# Use in: React frontend, Vercel deployment, local testing

# ─────────────────────────────────────────────────────────────
# 1. MeeChain RPC Configuration
# ─────────────────────────────────────────────────────────────

# RPC Endpoint for MeeChain Network (Chain ID 13390)
REACT_APP_MEECHAIN_RPC_URL=https://rpc.meechain.live
REACT_APP_MEECHAIN_CHAIN_ID=13390
REACT_APP_MEECHAIN_NETWORK_NAME=MeeChain

# ─────────────────────────────────────────────────────────────
# 2. Deployed Contract Addresses
# ─────────────────────────────────────────────────────────────

# MEEToken (ERC20) Contract Address
# Update after deploying MEEToken via GitHub Actions
REACT_APP_MEE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# MEEReward (ERC721 Soulbound NFT) Contract Address
# Update after deploying MEEReward via GitHub Actions
REACT_APP_MEE_REWARD_ADDRESS=0x0000000000000000000000000000000000000000

# ─────────────────────────────────────────────────────────────
# 3. IPFS & Metadata Configuration
# ─────────────────────────────────────────────────────────────

# IPFS Gateway for NFT metadata retrieval
REACT_APP_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Pinata API Keys (optional - for uploading metadata to IPFS)
# Get from: https://app.pinata.cloud/keys
REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here

# ─────────────────────────────────────────────────────────────
# 4. GitHub Actions Secrets
# ─────────────────────────────────────────────────────────────

# NOTE: These should be set in GitHub repository settings
# Settings → Secrets and variables → Actions

# Private key for contract deployment (GitHub Actions ONLY)
# ⚠️ SECURITY: Set in GitHub, never commit to .env
# PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Slack webhook for notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─────────────────────────────────────────────────────────────
# 5. Frontend API Configuration
# ─────────────────────────────────────────────────────────────

# MeeChain API Backend (for off-chain services)
REACT_APP_MEECHAIN_API_URL=https://api.meechain.live
REACT_APP_MEECHAIN_API_KEY=your_api_key_here

# ─────────────────────────────────────────────────────────────
# 6. Web3Auth Configuration (optional)
# ─────────────────────────────────────────────────────────────

# For social login + wallet integration
REACT_APP_WEB3AUTH_CLIENT_ID=your_web3auth_client_id

# ─────────────────────────────────────────────────────────────
# 7. Analytics & Monitoring
# ─────────────────────────────────────────────────────────────

# Google Analytics
REACT_APP_GA_ID=G_XXXXXXXXXX

# Sentry Error Tracking
REACT_APP_SENTRY_DSN=https://your_sentry_dsn

# ─────────────────────────────────────────────────────────────
# 8. Feature Flags
# ─────────────────────────────────────────────────────────────

# Enable/disable dashboard components
REACT_APP_ENABLE_DASHBOARD=true
REACT_APP_ENABLE_TRADING=false
REACT_APP_ENABLE_STAKING=false

# ═══════════════════════════════════════════════════════════════
# 📝 SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════

# 1. Copy this file to your project root as .env.local
#    cp .env.ci-cd .env.local

# 2. Update contract addresses after deployment:
#    - Deploy via GitHub Actions workflow
#    - Copy MEEToken address from GitHub Actions output
#    - Copy MEEReward address from GitHub Actions output
#    - Paste into REACT_APP_MEE_TOKEN_ADDRESS and REACT_APP_MEE_REWARD_ADDRESS

# 3. For GitHub Actions deployment, add secrets:
#    - Go to: Settings → Secrets and variables → Actions
#    - Add: PRIVATE_KEY (without 0x prefix)
#    - Add: MEECHAIN_RPC_URL (optional, defaults to https://rpc.meechain.live)
#    - Add: SLACK_WEBHOOK_URL (optional, for notifications)

# 4. For Vercel deployment:
#    - Create .env.local with REACT_APP_* variables
#    - Push to GitHub
#    - Vercel auto-detects and uses environment variables

# ═══════════════════════════════════════════════════════════════
# 🔐 SECURITY REMINDERS
# ═══════════════════════════════════════════════════════════════

# ✅ DO:
# - Add .env.local to .gitignore
# - Keep PRIVATE_KEY in GitHub Secrets only
# - Rotate keys every 3 months
# - Use different keys for dev/test/prod

# ❌ DON'T:
# - Commit .env.local to Git
# - Expose private keys in logs
# - Share secrets via Slack/email
# - Use same key for multiple environments

# ═══════════════════════════════════════════════════════════════
# 📚 ENVIRONMENT SETUP EXAMPLES
# ═══════════════════════════════════════════════════════════════

# --- Development (Local Machine) ---
# REACT_APP_MEECHAIN_RPC_URL=http://localhost:8545
# REACT_APP_MEE_TOKEN_ADDRESS=0x5b1869d9a4c187f2eaa108f3062412ecf0526b24
# (contract addresses from local deployment)

# --- Testnet (Mumbai/MeeChain Testnet) ---
# REACT_APP_MEECHAIN_RPC_URL=https://rpc-testnet.meechain.live
# REACT_APP_MEE_TOKEN_ADDRESS=0x...testnet_token_address...
# REACT_APP_MEE_REWARD_ADDRESS=0x...testnet_reward_address...

# --- Production (MeeChain Mainnet) ---
# REACT_APP_MEECHAIN_RPC_URL=https://rpc.meechain.live
# REACT_APP_MEE_TOKEN_ADDRESS=0x...mainnet_token_address...
# REACT_APP_MEE_REWARD_ADDRESS=0x...mainnet_reward_address...

